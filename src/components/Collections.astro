---
/**
 * 首页文章分类浏览。移植自 template-parts/collections.php + collection-list.php。
 *
 * 前端契约：
 *   - [data-collection-tab] 切换分类面板，并把 data-description 写进 [data-hub-description]
 *   - [data-collection-panel] 被 AJAX 返回的 html 整体替换
 *   - [data-hub-category] / [data-hub-type] / [data-hub-page] 交给 feng_hub 接口
 */
import { icon } from '../lib/icons';
import { renderCollectionList } from '../lib/render';
import type { PostMeta } from '../lib/content';

interface Props {
  posts: PostMeta[];
  categories: { name: string; count: number; description?: string }[];
}

const { posts, categories } = Astro.props;

const PER_PAGE = 6;
const totalPages = Math.max(1, Math.ceil(posts.length / PER_PAGE));
const firstPage = posts.slice(0, PER_PAGE);

const allHtml = renderCollectionList({
  posts: firstPage,
  category: 'all',
  type: 'latest',
  page: 1,
  totalPages,
  tint: '#f5f4f2',
  cover: firstPage[0]?.cover,
  categoryUrl: '/essay/',
});

/** 分类色调，与原主题的 feng_collection_tint 默认值一致。 */
const tintFor = (name: string) =>
  name === '旅行' ? '#f1f6f0' : name === '代码' ? '#f0f4fb' : '#f5f4f2';
---

<section id="xf-collections" class="xf-collections feng-article-hub" aria-label="文章分类与列表">
  <div hidden>
    <img data-hub-watermark alt="" hidden />
    <p data-hub-description></p>
  </div>

  <nav class="feng-article-hub__tabs" aria-label="文章分类">
    <button
      type="button"
      data-collection-tab="all"
      data-description="记录生活，也分享实践。"
      aria-pressed="true"
      aria-controls="collection-panel-all"
    >
      全部
    </button>
    {
      categories.map((category) => (
        <button
          type="button"
          data-collection-tab={category.name}
          data-description={category.description || `关于${category.name}，一些实践与记录。`}
          aria-label={category.name}
          data-hide-label="false"
          aria-pressed="false"
          aria-controls={`collection-panel-${category.name}`}
        >
          {category.name}
        </button>
      ))
    }
  </nav>

  <div id="collection-panel-all" data-collection-panel="all" data-hub-endpoint="/api/ajax">
    <Fragment set:html={allHtml} />
  </div>

  {
    categories.map((category) => (
      <div
        id={`collection-panel-${category.name}`}
        data-collection-panel={category.name}
        data-hub-endpoint="/api/ajax"
        data-hub-category={category.name}
        data-hub-lazy="1"
        hidden
      >
        <p class="feng-hub-placeholder">正在载入文章…</p>
      </div>
    ))
  }
</section>
