---
/**
 * 订阅页。移植自 pages/subscriptions.php。
 *
 * feng-feed 模块会接管 [data-feed-page] 内的翻页与周期切换，
 * 用 /api/ajax?action=feng_feed_list 取得整块 HTML 替换 [data-feed-entries]。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { icon } from '../lib/icons';
import { feed } from '../lib/data';
import { renderFeedRows, type FeedRow } from '../lib/render';

const sources = feed.subscriptions ?? [];
const rows: FeedRow[] = sources.flatMap((source) =>
  (source.latestItems ?? []).map((item) => ({
    title: item.title,
    url: item.url,
    date: item.date,
    summary: item.summary,
    source: source.name,
  })),
);
const today = new Date().toISOString().slice(0, 10);
const todayCount = rows.filter((row) => (row.date ?? '').startsWith(today)).length;
---

<BaseLayout kind="page" title="订阅" description="把朋友们的更新，放在这里。">
  <div class="feng-panel feng-special-page feng-subscriptions" data-feed-page>
    <header class="feng-page-heading feng-feed-hero feng-unified-heading">
      <div class="feng-feed-hero-copy">
        <h1><i class="fa-solid fa-rss feng-page-title-icon" aria-hidden="true"></i> 订阅</h1>
      </div>
      <div class="feng-feed-overview">
        <span><Fragment set:html={icon('rss')} /> <strong>{sources.length}</strong> 个订阅</span>
        <span><strong data-feed-today-number>{todayCount}</strong> 篇今日更新</span>
        <span class="feng-feed-last-sync">
          <Fragment set:html={icon('clock')} /> <span>友链 RSS · 30 分钟缓存</span>
        </span>
      </div>
    </header>

    <div class="feng-feed-toolbar">
      <div class="feng-feed-tabs" role="group" aria-label="更新范围">
        <button type="button" data-feed-period="all" aria-pressed="true">全部动态</button>
        <button type="button" data-feed-period="today" aria-pressed="false">今日更新</button>
      </div>
      {/*
        刷新：跳过缓存，重新抓一遍各订阅源的 RSS。
        主题的 feng-feed 模块负责日常加载，这个按钮走 feng_feed_refresh，
        抓完直接替换 [data-feed-entries]。
      */}
      <button type="button" class="feng-feed-refresh" data-feed-refresh>
        <Fragment set:html={icon('refresh')} /> 刷新订阅
      </button>
    </div>

    <p class="feng-feed-status" data-feed-status role="status">
      {rows.length ? `已收录 ${rows.length} 篇文章` : '还没有同步到动态'}
    </p>

    <div class="feng-feed-entries" data-feed-entries set:html={renderFeedRows(rows)} />

    <div class="feng-feed-empty" data-feed-empty hidden={rows.length > 0}>
      <Fragment set:html={icon('rss')} />
      <h2>{sources.length ? '等待下一封远方来信' : '把朋友的更新，放在这里'}</h2>
      <p>
        {sources.length
          ? '订阅源同步后，新文章会出现在这里。'
          : '添加友情链接的 RSS 地址后，就能在这里看到大家的文章。'}
      </p>
      <a href="/admin/">设置订阅 <Fragment set:html={icon('arrow-up-right')} /></a>
    </div>

    <button type="button" class="feng-feed-more" data-feed-more hidden>再看一些 <Fragment set:html={icon('arrow-down')} /></button>

    <footer class="feng-feed-footer">
      <span>按原文发布时间排序 · 点击标题前往朋友的博客</span>
    </footer>
  </div>

  <script is:inline>
    /*
      「刷新订阅」按钮：跳过 30 分钟缓存，重新抓一遍各订阅源的 RSS，
      抓完直接替换 [data-feed-entries]（主题的 feng-feed 模块也用这个容器）。
    */
    (function () {
      var button = document.querySelector('[data-feed-refresh]');
      if (!button) return;
      button.addEventListener('click', function () {
        var entries = document.querySelector('[data-feed-entries]');
        var status = document.querySelector('[data-feed-status]');
        var empty = document.querySelector('[data-feed-empty]');
        var label = button.innerHTML;
        button.disabled = true;
        button.textContent = '刷新中…';
        fetch('/api/ajax?action=feng_feed_refresh&force=1&page=1', { credentials: 'same-origin' })
          .then(function (response) {
            return response.json();
          })
          .then(function (result) {
            if (!result.success) throw new Error((result.data && result.data.message) || '刷新失败');
            var data = result.data;
            if (entries) entries.innerHTML = data.html;
            if (status) status.textContent = '共 ' + data.total + ' 篇文章 · 刚刚刷新';
            if (empty) empty.hidden = !!data.total;
          })
          .catch(function (error) {
            if (status) status.textContent = error.message;
          })
          .finally(function () {
            button.disabled = false;
            button.innerHTML = label;
          });
      });
    })();
  </script>
</BaseLayout>
