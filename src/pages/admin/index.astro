---
/**
 * 站点管理页。
 *
 * 替代原 WordPress 主题的后台设置面板：集中管理说说、评论与站点信息。
 * 界面沿用山映主题的配色变量，因此会跟随深浅配色。
 *
 * 安全：管理口令来自环境变量 `SHANYING_ADMIN_TOKEN`
 *（Cloudflare 上是 Worker secret，Node 上是 .env）。
 * 输入口令后会换成一个 HttpOnly 的签名会话 Cookie，
 * 前台说说页凭这个 Cookie 判断「是站长」，从而允许直接发布说说。
 * 没配置口令时整个管理页关闭。
 */
export const prerender = false;

import { SITE } from '../../config/site';
import { secretConfigured } from '../../lib/admin-session';

const tokenEnabled = secretConfigured();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>站点管理 · {SITE.title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/css/main.css" />
    <style is:inline>
      .feng-admin {
        max-width: 960px;
        margin: 0 auto;
        padding: 40px 20px 80px;
        font-family: var(--xf-font);
        color: var(--xf-text);
      }
      .feng-admin__head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        padding-bottom: 20px;
        border-bottom: 1px solid var(--xf-line);
      }
      .feng-admin__head h1 {
        font-size: 24px;
        margin: 0;
      }
      .feng-admin__kicker {
        font-size: 11px;
        letter-spacing: 0.18em;
        color: var(--xf-muted);
        margin: 0 0 6px;
      }
      .feng-admin__tabs {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        margin: 24px 0;
      }
      .feng-admin__tabs button {
        border: 1px solid var(--xf-line);
        background: transparent;
        color: inherit;
        padding: 8px 16px;
        border-radius: 999px;
        font-size: 13px;
        cursor: pointer;
      }
      .feng-admin__tabs button[aria-selected='true'] {
        background: var(--xf-accent);
        color: var(--xf-accent-text);
        border-color: transparent;
      }
      .feng-admin__panel[hidden] {
        display: none;
      }
      .feng-admin__stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 12px;
        margin-bottom: 28px;
      }
      .feng-admin__stat {
        border: 1px solid var(--xf-line);
        border-radius: 18px;
        padding: 16px 18px;
        background: var(--xf-surface);
        color: inherit;
        font: inherit;
        text-align: start;
        cursor: pointer;
        transition: border-color .2s, transform .2s;
      }
      .feng-admin__stat:hover {
        border-color: var(--xf-accent);
        transform: translateY(-2px);
      }
      .feng-admin__stat:focus-visible {
        outline: 2px solid var(--xf-focus);
        outline-offset: 3px;
      }
      .feng-admin__stat strong {
        display: block;
        font-size: 24px;
        font-variant-numeric: tabular-nums;
      }
      .feng-admin__stat span {
        font-size: 12px;
        color: var(--xf-muted);
      }
      .feng-admin__hint {
        margin: -14px 0 16px;
        font-size: 12px;
        color: var(--xf-muted);
      }
      .feng-admin__dialog {
        width: min(760px, calc(100% - 32px));
        max-height: min(72dvh, 660px);
        padding: 0;
        border: 1px solid var(--xf-line);
        border-radius: 22px;
        background: var(--xf-surface);
        color: var(--xf-text);
        box-shadow: var(--xf-shadow);
        overflow: hidden;
      }
      .feng-admin__dialog::backdrop {
        background: rgb(15 17 26 / .4);
      }
      .feng-admin__dialog-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 18px 22px;
        border-bottom: 1px solid var(--xf-line);
      }
      .feng-admin__dialog-head h2 {
        font-size: 16px;
        margin: 0;
      }
      .feng-admin__dialog-close {
        border: 1px solid var(--xf-line);
        background: transparent;
        color: inherit;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        cursor: pointer;
        font-size: 17px;
        line-height: 1;
        flex-shrink: 0;
      }
      .feng-admin__dialog-close:hover {
        border-color: var(--xf-accent);
        color: var(--xf-accent);
      }
      .feng-admin__dialog-body {
        padding: 4px 22px 22px;
        max-height: calc(min(72dvh, 660px) - 74px);
        overflow: auto;
        overscroll-behavior: contain;
      }
      .feng-admin__tag {
        display: inline-block;
        font-size: 11px;
        background: var(--xf-soft);
        color: var(--xf-muted);
        border-radius: 999px;
        padding: 2px 9px;
        margin: 4px 6px 0 0;
      }
      .feng-admin__link {
        color: var(--xf-accent);
        font-size: 12px;
        text-decoration: none;
        white-space: nowrap;
      }
      .feng-admin__link:hover {
        text-decoration: underline;
      }
      .feng-admin__bar {
        height: 6px;
        border-radius: 999px;
        background: var(--xf-soft);
        overflow: hidden;
        margin-top: 8px;
      }
      .feng-admin__bar i {
        display: block;
        height: 100%;
        border-radius: 999px;
        background: var(--xf-accent);
      }
      .feng-admin__total {
        font-size: 34px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        margin: 4px 0 18px;
      }
      .feng-admin__card {
        border: 1px solid var(--xf-line);
        border-radius: 22px;
        padding: 20px;
        background: var(--xf-surface);
        margin-bottom: 16px;
      }
      .feng-admin__card h2 {
        font-size: 15px;
        margin: 0 0 14px;
      }
      .feng-admin__row {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        padding: 12px 0;
        border-top: 1px solid var(--xf-line);
      }
      .feng-admin__row:first-of-type {
        border-top: 0;
      }
      .feng-admin__row-body {
        flex: 1;
        min-width: 0;
      }
      .feng-admin__row-body strong {
        font-size: 13px;
      }
      .feng-admin__row-body p {
        margin: 4px 0 0;
        font-size: 13px;
        color: var(--xf-muted);
        overflow-wrap: anywhere;
      }
      .feng-admin__row-body time {
        font-size: 11px;
        color: var(--xf-muted);
      }
      .feng-admin__actions {
        display: flex;
        gap: 8px;
        flex-shrink: 0;
      }
      .feng-admin__actions button {
        border: 1px solid var(--xf-line);
        background: transparent;
        color: inherit;
        border-radius: 10px;
        padding: 6px 12px;
        font-size: 12px;
        cursor: pointer;
      }
      .feng-admin__actions button:hover {
        border-color: var(--xf-accent);
        color: var(--xf-accent);
      }
      .feng-admin__actions button[data-danger]:hover {
        border-color: #e5484d;
        color: #e5484d;
      }
      .feng-admin__form {
        display: grid;
        gap: 12px;
      }
      .feng-admin__form label {
        display: grid;
        gap: 6px;
        font-size: 12px;
        color: var(--xf-muted);
      }
      .feng-admin__form input,
      .feng-admin__form textarea {
        width: 100%;
        box-sizing: border-box;
        border: 1px solid var(--xf-line);
        background: var(--xf-bg);
        color: var(--xf-text);
        border-radius: 12px;
        padding: 10px 12px;
        font: inherit;
        font-size: 14px;
      }
      .feng-admin__form textarea {
        min-height: 96px;
        resize: vertical;
      }
      .feng-admin__submit {
        justify-self: start;
        border: 0;
        background: var(--xf-accent);
        color: var(--xf-accent-text);
        border-radius: 999px;
        padding: 9px 22px;
        font-size: 13px;
        cursor: pointer;
      }
      .feng-admin__status {
        font-size: 13px;
        color: var(--xf-muted);
        min-height: 1.4em;
        margin: 10px 0 0;
      }
      .feng-admin__head-actions {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .feng-admin__head-actions .feng-admin__status {
        margin: 0;
      }
      .feng-admin__logout {
        border: 1px solid var(--xf-line);
        background: transparent;
        color: inherit;
        border-radius: 999px;
        padding: 6px 14px;
        font-size: 12px;
        cursor: pointer;
      }
      .feng-admin__logout:hover {
        border-color: var(--xf-accent);
        color: var(--xf-accent);
      }
      .feng-admin__gate {
        max-width: 360px;
        margin: 80px auto;
        text-align: center;
      }
    </style>
  </head>

  <body>
    <div class="feng-admin">
      <header class="feng-admin__head">
        <div>
          <p class="feng-admin__kicker">SHANYING · CONTROL</p>
          <h1>站点管理</h1>
        </div>
        <div class="feng-admin__head-actions">
          <span class="feng-admin__status" data-admin-status role="status"></span>
          <button class="feng-admin__logout" type="button" data-admin-logout hidden>退出登录</button>
          <a class="xf-icon-button" href="/" aria-label="返回站点">←</a>
        </div>
      </header>

      {
        tokenEnabled ? (
          <section class="feng-admin__gate" data-gate>
            <h2>需要管理令牌</h2>
            <p class="feng-admin__status">该站点已开启令牌校验，请输入 SHANYING_ADMIN_TOKEN。</p>
            <form class="feng-admin__form" data-gate-form>
              <label>
                管理令牌
                <input type="password" name="token" autocomplete="current-password" required />
              </label>
              <button class="feng-admin__submit" type="submit">进入</button>
            </form>
          </section>
        ) : (
          <p class="feng-admin__status">
            当前未配置管理口令（SHANYING_ADMIN_TOKEN），管理接口处于关闭状态。
            本地开发请在项目根目录的 .env 里写入该变量后重启；Cloudflare 上请执行
            <code>npx wrangler secret put SHANYING_ADMIN_TOKEN</code>。
          </p>
        )
      }

      <div data-admin hidden>
        <nav class="feng-admin__tabs" role="tablist">
          <button type="button" role="tab" data-tab="overview" aria-selected="true">概览</button>
          <button type="button" role="tab" data-tab="talks" aria-selected="false">说说</button>
          <button type="button" role="tab" data-tab="comments" aria-selected="false">评论</button>
          <button type="button" role="tab" data-tab="settings" aria-selected="false">站点信息</button>
        </nav>

        <section class="feng-admin__panel" data-panel="overview">
          <div class="feng-admin__stats" data-stats></div>
          <p class="feng-admin__hint">点击任意统计卡片，可以在这里弹出对应的明细列表进行管理。</p>
        </section>

        <section class="feng-admin__panel" data-panel="talks" hidden>
          <div class="feng-admin__card">
            <h2>发布说说</h2>
            <form class="feng-admin__form" data-talk-form>
              <label>
                正文
                <textarea name="content" required maxlength="4000" placeholder="此刻，想说点什么？"></textarea>
              </label>
              <label>
                关键词（逗号分隔，最多 4 个）
                <input name="tags" maxlength="100" placeholder="生活，随想…" />
              </label>
              <button class="feng-admin__submit" type="submit">发布</button>
            </form>
            <p class="feng-admin__status" data-talk-status></p>
          </div>
          <div class="feng-admin__card">
            <h2>已有说说</h2>
            <div data-talk-list></div>
          </div>
        </section>

        <section class="feng-admin__panel" data-panel="comments" hidden>
          <div class="feng-admin__card">
            <h2>评论</h2>
            <div data-comment-list></div>
          </div>
        </section>

        <section class="feng-admin__panel" data-panel="settings" hidden>
          <div class="feng-admin__card">
            <h2>站点信息</h2>
            <form class="feng-admin__form" data-settings-form>
              <label>站点名称<input name="title" /></label>
              <label>副标题<input name="subtitle" /></label>
              <label>站点描述<textarea name="description"></textarea></label>
              <label>作者<input name="author" /></label>
              <label>邮箱<input name="email" type="email" /></label>
              <label>ICP 备案号<input name="icpNumber" /></label>
              <label>公安备案号<input name="policeNumber" /></label>
              <label>GitHub<input name="github" type="url" /></label>
              <label>X / Twitter<input name="x" type="url" /></label>
              <button class="feng-admin__submit" type="submit">保存</button>
            </form>
            <p class="feng-admin__status" data-settings-status></p>
          </div>
        </section>
      </div>
    </div>

    <dialog class="feng-admin__dialog" id="admin-list">
      <div class="feng-admin__dialog-head">
        <h2 data-admin-list-title>列表</h2>
        <button class="feng-admin__dialog-close" type="button" data-admin-list-close aria-label="关闭">×</button>
      </div>
      <div class="feng-admin__dialog-body" data-admin-list-body></div>
    </dialog>

    <script is:inline define:vars={{ tokenEnabled }}>
      (function () {
        var root = document.querySelector('[data-admin]');
        var gate = document.querySelector('[data-gate]');
        var token = '';
        try {
          token = localStorage.getItem('shanying-admin-token') || '';
        } catch (e) {}

        function setStatus(selector, text, isError) {
          var node = document.querySelector(selector);
          if (!node) return;
          node.textContent = text;
          node.style.color = isError ? '#e5484d' : '';
        }

        // 操作结果同时写到页头状态栏与说说面板，弹窗里操作时也能看到反馈。
        function setActionStatus(text, isError) {
          setStatus('[data-admin-status]', text, isError);
          setStatus('[data-talk-status]', text, isError);
        }

        function api(path, body) {
          var url = '/api/admin' + (token ? '?token=' + encodeURIComponent(token) : '');
          return fetch(url, {
            method: body ? 'POST' : 'GET',
            headers: { 'content-type': 'application/json' },
            body: body ? JSON.stringify(Object.assign({ token: token }, body)) : undefined,
          })
            .then(function (response) {
              return response.json().then(function (result) {
                if (!result.success) throw new Error(result.data?.message || '操作失败');
                return result.data;
              });
            });
        }

        function esc(value) {
          return String(value == null ? '' : value).replace(/[&<>"']/g, function (char) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[char];
          });
        }

        function renderStats(data) {
          var stats = [
            ['posts', '文章', data.overview.posts],
            ['talks', '说说', data.overview.talks],
            ['comments', '评论', data.overview.comments],
            ['friends', '友链', data.overview.friends],
            ['subscriptions', '订阅源', data.overview.subscriptions],
            ['words', '总字数', data.overview.words],
            ['views', '总浏览', data.overview.pageViews],
          ];
          document.querySelector('[data-stats]').innerHTML = stats
            .map(function (item) {
              return (
                '<button type="button" class="feng-admin__stat" data-list="' +
                esc(item[0]) +
                '"><strong>' +
                Number(item[2]).toLocaleString('zh-CN') +
                '</strong><span>' +
                esc(item[1]) +
                '</span></button>'
              );
            })
            .join('');
        }

        function talkRows(talks) {
          if (!talks.length) return '<p class="feng-admin__status">还没有运行期发布的说说。</p>';
          return talks
            .map(function (talk) {
              return (
                '<div class="feng-admin__row"><div class="feng-admin__row-body"><strong>' +
                esc(talk.content) +
                '</strong><p><time>' +
                esc(new Date(talk.createdAt).toLocaleString('zh-CN')) +
                '</time></p></div><div class="feng-admin__actions"><button type="button" data-talk-delete="' +
                esc(talk.id) +
                '" data-danger>删除</button></div></div>'
              );
            })
            .join('');
        }

        function commentRows(comments) {
          if (!comments.length) return '<p class="feng-admin__status">还没有评论。</p>';
          return comments
            .map(function (comment) {
              return (
                '<div class="feng-admin__row"><div class="feng-admin__row-body"><strong>' +
                esc(comment.author) +
                ' · ' +
                esc(comment.postId) +
                '</strong><p>' +
                esc(comment.content) +
                '</p><time>' +
                esc(new Date(comment.date).toLocaleString('zh-CN')) +
                '</time></div><div class="feng-admin__actions"><button type="button" data-comment-approve="' +
                esc(comment.id) +
                '" data-approved="' +
                (comment.approved ? '1' : '0') +
                '">' +
                (comment.approved ? '转为待审' : '通过') +
                '</button><button type="button" data-comment-delete="' +
                esc(comment.id) +
                '" data-danger>删除</button></div></div>'
              );
            })
            .join('');
        }

        function renderTalks(talks) {
          document.querySelector('[data-talk-list]').innerHTML = talkRows(talks);
        }

        function renderComments(comments) {
          document.querySelector('[data-comment-list]').innerHTML = commentRows(comments);
        }

        function postRows(posts) {
          if (!posts.length) return '<p class="feng-admin__status">还没有已发布的文章。</p>';
          return posts
            .map(function (post) {
              var tags = (post.tags || [])
                .map(function (tag) {
                  return '<span class="feng-admin__tag">' + esc(tag) + '</span>';
                })
                .join('');
              return (
                '<div class="feng-admin__row"><div class="feng-admin__row-body"><strong>' +
                esc(post.title) +
                '</strong><p>' +
                esc(post.date) +
                ' · ' +
                esc(post.category) +
                ' · ' +
                Number(post.words).toLocaleString('zh-CN') +
                ' 字 · ' +
                Number(post.views).toLocaleString('zh-CN') +
                ' 浏览 · ' +
                Number(post.commentCount).toLocaleString('zh-CN') +
                ' 评论</p>' +
                tags +
                '</div><div class="feng-admin__actions"><a class="feng-admin__link" href="' +
                esc(post.url) +
                '" target="_blank" rel="noopener">查看</a></div></div>'
              );
            })
            .join('');
        }

        function friendRows(friends) {
          if (!friends.length) return '<p class="feng-admin__status">还没有启用中的友链。</p>';
          return friends
            .map(function (friend) {
              return (
                '<div class="feng-admin__row"><div class="feng-admin__row-body"><strong>' +
                esc(friend.name) +
                '</strong><p>' +
                esc(friend.description || '—') +
                '</p>' +
                (friend.feed ? '<p>订阅地址：' + esc(friend.feed) + '</p>' : '') +
                '</div><div class="feng-admin__actions"><a class="feng-admin__link" href="' +
                esc(friend.url) +
                '" target="_blank" rel="noopener">访问</a></div></div>'
              );
            })
            .join('');
        }

        function subscriptionRows(subscriptions) {
          if (!subscriptions.length) return '<p class="feng-admin__status">还没有订阅源。</p>';
          return subscriptions
            .map(function (subscription) {
              return (
                '<div class="feng-admin__row"><div class="feng-admin__row-body"><strong>' +
                esc(subscription.name) +
                '</strong><p>' +
                esc(subscription.description || '—') +
                '</p><p>订阅地址：' +
                esc(subscription.feedUrl || '—') +
                '</p></div><div class="feng-admin__actions"><a class="feng-admin__link" href="' +
                esc(subscription.url) +
                '" target="_blank" rel="noopener">主页</a></div></div>'
              );
            })
            .join('');
        }

        function wordRows(stats) {
          var categories = stats.categories || [];
          var max = categories.reduce(function (top, item) {
            return Math.max(top, item.words);
          }, 0);
          if (!max) max = 1;
          var bars = categories
            .map(function (item) {
              return (
                '<div class="feng-admin__row"><div class="feng-admin__row-body"><strong>' +
                esc(item.category) +
                '</strong><p>' +
                Number(item.count).toLocaleString('zh-CN') +
                ' 篇 · ' +
                Number(item.words).toLocaleString('zh-CN') +
                ' 字</p><div class="feng-admin__bar"><i style="width:' +
                Math.round((item.words / max) * 100) +
                '%"></i></div></div></div>'
              );
            })
            .join('');
          return (
            '<p class="feng-admin__total">' +
            Number(stats.total).toLocaleString('zh-CN') +
            '</p><p class="feng-admin__status">全站正文总字数（按字符统计），下面是按分类的分布。</p>' +
            bars
          );
        }

        function viewRows(views) {
          return (
            '<p class="feng-admin__total">' +
            Number(views).toLocaleString('zh-CN') +
            '</p><p class="feng-admin__status">站点累计浏览量，来自运行期的访问计数器。</p>'
          );
        }

        function renderSettings(settings) {
          var form = document.querySelector('[data-settings-form]');
          Object.keys(settings).forEach(function (key) {
            var field = form.elements[key];
            if (field && !field.value) field.value = settings[key] || '';
          });
        }

        // —— 概览卡片弹出的明细列表 ——
        var state = null;
        var currentList = '';
        var dialog = document.getElementById('admin-list');

        var listTitles = {
          posts: '文章列表',
          talks: '说说列表',
          comments: '评论列表',
          friends: '友链列表',
          subscriptions: '订阅列表',
          words: '总字数',
          views: '总浏览量',
        };

        function listBody(kind) {
          if (!state) return '<p class="feng-admin__status">数据还没加载完，请稍候。</p>';
          if (kind === 'posts') return postRows(state.posts || []);
          if (kind === 'talks') return talkRows(state.talks || []);
          if (kind === 'comments') return commentRows(state.comments || []);
          if (kind === 'friends') return friendRows(state.friends || []);
          if (kind === 'subscriptions') return subscriptionRows(state.subscriptions || []);
          if (kind === 'words') return wordRows(state.wordStats || { total: 0, categories: [] });
          if (kind === 'views') return viewRows(state.overview ? state.overview.pageViews : 0);
          return '';
        }

        function paintList() {
          var title = document.querySelector('[data-admin-list-title]');
          var body = document.querySelector('[data-admin-list-body]');
          if (title) title.textContent = listTitles[currentList] || '列表';
          if (body) body.innerHTML = listBody(currentList);
        }

        function openList(kind) {
          currentList = kind;
          paintList();
          if (dialog && !dialog.open) {
            try {
              dialog.showModal();
            } catch (e) {
              dialog.setAttribute('open', '');
            }
          }
        }

        function closeList() {
          if (dialog && dialog.open) dialog.close();
        }

        function refresh() {
          return api('/api/admin')
            .then(function (data) {
              state = data;
              renderStats(data);
              renderTalks(data.talks);
              renderComments(data.comments);
              renderSettings(data.settings);
              // 弹窗开着的时候同步刷新列表内容，避免操作后看到旧数据。
              if (dialog && dialog.open) paintList();
            })
            .catch(function (error) {
              setActionStatus(error.message, true);
            });
        }

        function show() {
          if (gate) gate.hidden = true;
          root.hidden = false;
          var logout = document.querySelector('[data-admin-logout]');
          if (logout) logout.hidden = false;
          refresh();
        }

        // 用管理口令换取签名会话 Cookie，之后前台说说页才能识别「是站长」。
        function login() {
          return api('/api/admin', { action: 'admin.login' });
        }

        if (!tokenEnabled) {
          // 没有配置管理口令时保持关闭状态，不进入管理面板。
        } else if (token) {
          login()
            .then(show)
            .catch(function () {
              if (gate) gate.hidden = false;
              setStatus('[data-gate] .feng-admin__status', '登录状态已失效，请重新输入管理令牌。', true);
            });
        } else {
          var gateForm = document.querySelector('[data-gate-form]');
          gateForm.addEventListener('submit', function (event) {
            event.preventDefault();
            token = gateForm.elements.token.value.trim();
            login()
              .then(function () {
                try {
                  localStorage.setItem('shanying-admin-token', token);
                } catch (e) {}
                show();
              })
              .catch(function (error) {
                setStatus('[data-gate] .feng-admin__status', error.message, true);
              });
          });
        }

        var logoutButton = document.querySelector('[data-admin-logout]');
        if (logoutButton) {
          logoutButton.addEventListener('click', function () {
            api('/api/admin', { action: 'admin.logout' })
              .then(function () {
                logoutButton.hidden = true;
                setStatus('[data-admin-status]', '已退出登录：前台的「发布说说」需要重新登录。');
              })
              .catch(function (error) {
                setStatus('[data-admin-status]', error.message, true);
              });
          });
        }

        document.querySelectorAll('[data-tab]').forEach(function (button) {
          button.addEventListener('click', function () {
            document.querySelectorAll('[data-tab]').forEach(function (item) {
              item.setAttribute('aria-selected', String(item === button));
            });
            document.querySelectorAll('[data-panel]').forEach(function (panel) {
              panel.hidden = panel.dataset.panel !== button.dataset.tab;
            });
          });
        });

        // 概览统计卡片：点击后弹出对应明细列表。
        document.querySelectorAll('[data-stats]').forEach(function (container) {
          container.addEventListener('click', function (event) {
            var target = event.target;
            if (!(target instanceof Element)) return;
            var card = target.closest('[data-list]');
            if (!card) return;
            openList(card.dataset.list);
          });
        });

        var listClose = document.querySelector('[data-admin-list-close]');
        if (listClose) {
          listClose.addEventListener('click', function () {
            closeList();
          });
        }

        if (dialog) {
          // 点击遮罩关闭弹窗（Esc 由 dialog 原生支持）。
          dialog.addEventListener('click', function (event) {
            if (event.target === dialog) closeList();
          });
        }

        document.addEventListener('click', function (event) {
          var target = event.target;
          if (!(target instanceof Element)) return;
          var talkDelete = target.closest('[data-talk-delete]');
          if (talkDelete) {
            api('/api/admin', { action: 'talk.delete', id: talkDelete.dataset.talkDelete })
              .then(function () {
                setActionStatus('已删除。');
                refresh();
              })
              .catch(function (error) {
                setActionStatus(error.message, true);
              });
            return;
          }
          var approve = target.closest('[data-comment-approve]');
          if (approve) {
            var next = approve.dataset.approved === '1' ? '0' : '1';
            api('/api/admin', { action: 'comment.approve', id: approve.dataset.commentApprove, approved: next })
              .then(refresh)
              .catch(function (error) {
                setActionStatus(error.message, true);
              });
            return;
          }
          var commentDelete = target.closest('[data-comment-delete]');
          if (commentDelete) {
            api('/api/admin', { action: 'comment.delete', id: commentDelete.dataset.commentDelete })
              .then(refresh)
              .catch(function (error) {
                setActionStatus(error.message, true);
              });
          }
        });

        var talkForm = document.querySelector('[data-talk-form]');
        talkForm.addEventListener('submit', function (event) {
          event.preventDefault();
          api('/api/admin', {
            action: 'talk.save',
            content: talkForm.elements.content.value,
            tags: talkForm.elements.tags.value,
          })
            .then(function (data) {
              talkForm.reset();
              setActionStatus(data.message);
              refresh();
            })
            .catch(function (error) {
              setActionStatus(error.message, true);
            });
        });

        var settingsForm = document.querySelector('[data-settings-form]');
        settingsForm.addEventListener('submit', function (event) {
          event.preventDefault();
          var payload = { action: 'settings.save' };
          new FormData(settingsForm).forEach(function (value, key) {
            payload[key] = value;
          });
          api('/api/admin', payload)
            .then(function (data) {
              setStatus('[data-settings-status]', data.message);
            })
            .catch(function (error) {
              setStatus('[data-settings-status]', error.message, true);
            });
        });
      })();
    </script>
  </body>
</html>
