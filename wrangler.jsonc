{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shanying-astro-theme",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  // 运行期数据（留言 / 说说 / 宠物进度 / 浏览量）落在这个 KV namespace。
  // 不写 id：交给 wrangler 自动开通，部署时会在账号下建好并复用。
  "kv_namespaces": [
    {
      "binding": "SHANYING_STORE"
    }
  ],
  "observability": {
    "enabled": true
  }
}
